<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home page</title>
</head>

<body>
    <h1>URL shortner</h1>
    <% if (locals.shortenedURL) { %>
        <p>
            Short URL generated:
            <a href="/url/<%= shortenedURL %>">
                https://localhost:3000/url/<%= shortenedURL %>
            </a>
        </p>
    <% } %>
    <div>
        <form method="POST" action="/url">
            <label>Enter your URL</label>
            <input type="text" name="redirectURL" placeholder="https://www.youtube.com/" />
            <button type="submit">Generate</button>
        </form>
    </div>

    <form method="POST" action="/user/logout">
        <button type="submit">Logout</button>
    </form>
    <% urls.forEach(url=> { %>
        <li>
            <%= url.shortId %> - <%= url.redirectURL %>
        </li>
        <%})%>
</body>

</html>